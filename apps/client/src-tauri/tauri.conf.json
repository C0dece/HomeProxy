{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeProxy Agent",
  "version": "0.1.2",
  "identifier": "app.homeproxy.agent",
  "build": {
    "frontendDist": "../../../dist/agent"
  },
  "app": {
    "windows": [{ "title": "HomeProxy Agent", "width": 820, "height": 685, "minWidth": 355, "minHeight": 420 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] },
  "plugins": { "updater": { "pubkey": "" } }
}
