{
  "name": "homeproxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "dev:agent": "vite --config apps/client/vite.config.ts",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:agent": "vite build --config apps/client/vite.config.ts",
    "build:browser": "node scripts/build-browser.mjs",
    "build": "npm run build:admin && npm run build:agent && npm run build:browser",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/chrome": "0.1.32",
    "@types/node": "24.13.2",
    "esbuild": "0.28.1",
    "svelte": "5.59.1",
    "svelte-check": "4.4.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "lucide-svelte": "0.575.0"
  }
}
