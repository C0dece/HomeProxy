{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["chrome", "node", "svelte", "vite/client"],
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.svelte", "packages/**/*.ts", "packages/**/*.svelte"]
}
